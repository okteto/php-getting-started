# Send only what the PHP images need to the build context: the PHP files,
# the Composer files, the page, and the Xdebug settings.
# Anything else (.git, manifests, docs) would bloat the images and
# invalidate the build cache on every unrelated change.
*
!composer.json
!composer.lock
!**/*.php
!static
!xdebug.ini
vendor/**
